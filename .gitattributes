* text=auto eol=lf

# Fixtures are kept byte for byte (line endings and Base64 layout included).
/tests/fixtures/verifactu/** -text -eol

# Development files are left out of the Composer dist archive.
/.github            export-ignore
/docs               export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/CHANGELOG.md       export-ignore
