{
    "name": "intragile/laravel-einvoicing",
    "description": "Laravel bridge for intragile/php-einvoicing: send and receive EN 16931 invoices over Peppol, French e-invoicing through B2Brouter, Polish KSeF FA(3) invoices and Spanish VERI*FACTU billing records, with configured transports, queued sending under a guarded delivery state machine, inbound documents, signed webhooks (Recommand, B2Brouter, e-invoice.be) and KSeF offline deadlines.",
    "keywords": [
        "laravel",
        "e-invoicing",
        "einvoice",
        "peppol",
        "en16931",
        "ubl",
        "recommand",
        "b2brouter",
        "webhook",
        "queue",
        "france",
        "ksef",
        "fa3",
        "poland",
        "e-faktura",
        "verifactu",
        "aeat",
        "spain"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/laravel-einvoicing/issues",
        "source": "https://github.com/intragile/laravel-einvoicing",
        "security": "https://github.com/intragile/laravel-einvoicing/security/policy"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0",
        "intragile/einvoicing-rules-en16931": "^1.0",
        "intragile/einvoicing-rules-facturx": "^1.0",
        "intragile/einvoicing-rules-xrechnung": "^1.0",
        "intragile/php-einvoicing": "^1.3",
        "laravel/framework": "^12.71|^13.0"
    },
    "require-dev": {
        "chillerlan/php-qrcode": "^5",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.3.x-dev"
        },
        "laravel": {
            "providers": [
                "IntrAgile\\EInvoicing\\Laravel\\EInvoicingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
