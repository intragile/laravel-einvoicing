{
    "name": "intragile/laravel-einvoicing",
    "description": "Laravel bridge for intragile/php-einvoicing: send and receive EN 16931 invoices over Peppol, with configured transports, queued sending under a guarded delivery state machine, inbound documents and signed Recommand webhooks.",
    "keywords": [
        "laravel",
        "e-invoicing",
        "einvoice",
        "peppol",
        "en16931",
        "ubl",
        "recommand",
        "webhook",
        "queue"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/laravel-einvoicing/issues",
        "source": "https://github.com/intragile/laravel-einvoicing",
        "security": "https://github.com/intragile/laravel-einvoicing/security/policy"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.15.2",
        "intragile/einvoicing-rules-en16931": "^1.0",
        "intragile/einvoicing-rules-facturx": "^1.0",
        "intragile/einvoicing-rules-xrechnung": "^1.0",
        "intragile/php-einvoicing": "^1.0",
        "laravel/framework": "^12.71|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.5.8"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-einvoicing",
            "options": {
                "versions": {
                    "intragile/php-einvoicing": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../php-einvoicing/packages/rules-en16931",
            "options": {
                "versions": {
                    "intragile/einvoicing-rules-en16931": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../php-einvoicing/packages/rules-facturx",
            "options": {
                "versions": {
                    "intragile/einvoicing-rules-facturx": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../php-einvoicing/packages/rules-xrechnung",
            "options": {
                "versions": {
                    "intragile/einvoicing-rules-xrechnung": "1.0.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "IntrAgile\\EInvoicing\\Laravel\\EInvoicingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
