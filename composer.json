{
    "name": "intragile/laravel-einvoicing",
    "description": "Laravel bridge for intragile/php-einvoicing: configured Peppol transports, queued sending with a guarded delivery state machine, inbound documents and signed webhooks.",
    "keywords": [
        "laravel",
        "en16931",
        "e-invoicing",
        "einvoice",
        "peppol",
        "ubl",
        "invoice",
        "webhook"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/laravel-einvoicing/issues",
        "source": "https://github.com/intragile/laravel-einvoicing",
        "security": "https://github.com/intragile/laravel-einvoicing/security/policy"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "intragile/php-einvoicing": "^1.0@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-einvoicing"
        },
        {
            "type": "path",
            "url": "../php-einvoicing/packages/rules-en16931"
        }
    ],
    "autoload": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\EInvoicing\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "IntrAgile\\EInvoicing\\Laravel\\EInvoicingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
