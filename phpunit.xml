<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
        <testsuite name="Live"><directory>tests/Live</directory></testsuite>
    </testsuites>
    <groups>
        <exclude><group>peppol-rules</group><group>recommand-live</group><group>b2brouter-france-live</group><group>ksef-live</group><group>b2brouter-spain-live</group></exclude>
    </groups>
    <!-- failOnDeprecation turns a deprecation raised by src/, or by a library that src/ calls,
         into a failure. Deprecations raised between third-party packages are left out
         (ignoreIndirectDeprecations), because they are not ours to fix. Inside a bootstrapped
         test application Laravel's error handler takes over from PHPUnit's; there
         tests/Support/FirstPartyDeprecations applies the same rule. -->
    <source ignoreIndirectDeprecations="true">
        <include><directory>src</directory></include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
